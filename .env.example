VITE_APP_BASE_PATH=/renta/
VITE_FRONTEND_URL=http://localhost:5173/renta
VITE_DOCUSIGN_FRONTEND_URL=https://redskyg.com/renta
# Local primero
# VITE_API_BASE_URL=http://localhost:8000/api/v1
# VITE_BACKEND_ORIGIN=http://localhost:8000
VITE_API_URL=https://uber-aviones.onrender.com/api/v1
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_API_TIMEOUT_MS=15000
VITE_API_CREDENTIALS_MODE=same-origin
VITE_AUTH_API_TIMEOUT_MS=45000
# Fallback produccion Render
VITE_FALLBACK_API_BASE_URL=https://uber-aviones.onrender.com/api/v1
VITE_FALLBACK_BACKEND_ORIGIN=https://uber-aviones.onrender.com
# Referencia produccion directa
VITE_API_BASE_URL=https://uber-aviones.onrender.com/api/v1
VITE_BACKEND_ORIGIN=https://uber-aviones.onrender.com
VITE_AIRPORT_SEARCH_PATH=/public/airports/search
VITE_CLIENT_AIRCRAFT_PATH=/client/aircraft
VITE_CLIENT_TRIPS_PATH=/cliente/historial
# No usar rutas admin desde el portal cliente
VITE_CLIENT_TRIP_WORKFLOW_PATH=
VITE_CLIENT_RESERVATION_CONTRACT_SIGN_PATH=/cliente/reservas/:id/contrato/firmar
# Solo si tu backend expone un endpoint dedicado por contrato para reenviar a DocuSign.
# Si lo dejas vacio, el frontend usara la ruta por reserva para generar/enviar el contrato.
# VITE_CLIENT_CONTRACT_SEND_PATH=/contracts/:id/docusign/send
VITE_GOOGLE_AUTH_URL=https://tu-backend.com/auth/google
VITE_APPLE_AUTH_URL=https://tu-backend.com/auth/apple
